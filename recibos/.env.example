# Copie para .env (local) ou cadastre em Project Settings > Environment Variables (Vercel).
# Nunca versione os valores reais.

# Caixa remetente (Google Workspace / Gmail) e Senha de App (16 caracteres)
SMTP_USER=recibos@exemplo.com.br
SMTP_PASS=

# Nome exibido no remetente, assunto e assinatura do e-mail
REMETENTE_NOME=Escola de Idiomas Exemplo

# Hosts que podem chamar /api/enviar (separados por vírgula)
ALLOWED_HOSTS=recibos.exemplo.com.br,localhost:3000
# Opcional: prefixo dos deploys de preview (<prefixo><hash>.vercel.app)
ALLOWED_HOST_PREFIX=gerador-recibos-
